# ─────────────────────────────────────────────────────────────────────────────
# Stock-er 환경 변수 설정 예시
# 이 파일을 복사하여 .env.local 로 저장 후 값을 채워 주세요.
# .env.local 은 .gitignore 에 포함되어 커밋되지 않습니다.
# ─────────────────────────────────────────────────────────────────────────────

# Alpha Vantage 무료 API 키
#   발급: https://www.alphavantage.co/support/#api-key
#   무료 플랜: 분당 5회 · 일 25회 호출 제한
#
#   ★ 이 값을 설정하지 않으면 Seed 기반 Mock 데이터로 자동 폴백됩니다.
#   ★ 'demo' 키는 AAPL 단일 티커만 지원하는 Alpha Vantage 샘플 키입니다.
STOCK_API_KEY=your_api_key_here

# Finnhub 무료 API 키  ← Alpha Vantage 사용량 초과 시 자동 전환 (Fallback)
#   발급: https://finnhub.io  →  Sign up (무료) → Dashboard → API Key 복사
#   무료 플랜: 분당 60회 호출 (실질적 무제한)
#
#   ★ STOCK_API_KEY가 없거나 한도 초과 시 이 키로 자동 전환됩니다.
#   ★ 두 키 모두 미설정 시 Seed 기반 Mock 데이터로 폴백됩니다.
FINNHUB_API_KEY=your_finnhub_key_here
